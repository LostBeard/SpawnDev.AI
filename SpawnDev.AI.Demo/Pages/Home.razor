@page "/"
@using SpawnDev.AI
@using SpawnDev.AI.Server
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@inject AiWorkerClient Ai
@inject BlazorJSRuntime JS

<PageTitle>SpawnDev.AI — on-device AI chat</PageTitle>

<div class="sdai">
    <header class="sdai-hdr">
        <div class="brand">
            <span class="logo">🖖</span>
            <div>
                <h1>SpawnDev.AI</h1>
                <p>LLM chat + image generation, 100% on your GPU. Nothing leaves your device.</p>
            </div>
        </div>
        @if (_ready)
        {
            <div class="pickers">
                <label>Chat model
                    <select @bind="_model" disabled="@_busy">
                        @foreach (var m in _models) { <option value="@m">@m</option> }
                    </select>
                </label>
                <label>Image model
                    <select @bind="_imageModel" disabled="@_busy">
                        @foreach (var (name, _) in _imageModels) { <option value="@name">@name</option> }
                    </select>
                </label>
                <button class="gear @(_showSettings ? "on" : "")" @onclick="ToggleSettings" title="Agent settings (system prompt, temperature)">⚙️</button>
            </div>
        }
    </header>

    @if (_ready && _showSettings)
    {
        <div class="settings">
            <div class="setrow">
                <label class="setlbl">System prompt
                    <span class="sethint">Sets the assistant's persona and behavior. Image requests work regardless — the server auto-runs the image tool on any clear "draw / generate a picture" request.</span>
                </label>
                <textarea class="sysbox" @bind="_systemPrompt" @bind:event="oninput" rows="5" disabled="@_busy"
                          placeholder="(empty = no system prompt — a bare model)"></textarea>
                <div class="setactions">
                    <button class="linkbtn" @onclick="ResetSystemPrompt" disabled="@_busy">Reset to default</button>
                    <span class="setcount">@_systemPrompt.Length chars</span>
                </div>
            </div>
            <div class="setgrid">
                <label class="setlbl">Temperature <b>@_temperature.ToString("0.00")</b>
                    <input type="range" min="0" max="1.5" step="0.05" @bind="_temperature" @bind:event="oninput" disabled="@_busy" />
                    <span class="sethint">0 = focused/deterministic · higher = more creative &amp; varied</span>
                </label>
                <label class="setlbl">Max response tokens <b>@_maxTokens</b>
                    <input type="range" min="64" max="2048" step="64" @bind="_maxTokens" @bind:event="oninput" disabled="@_busy" />
                    <span class="sethint">Upper bound on reply length</span>
                </label>
            </div>
        </div>
    }

    @if (!_ready)
    {
        <div class="hero">
            <h2>Your browser is the AI server</h2>
            <p>
                One click starts a shared-worker model server on WebGPU. Weights stream peer-to-peer
                and cache in your browser — every tab shares the same resident model. Ask for a
                picture and the chat model will paint one with the on-device diffusion model.
            </p>
            <button class="primary big" @onclick="StartAsync" disabled="@_starting">
                @(_starting ? "Starting worker + WebGPU…" : "Start the AI server")
            </button>
            @if (!string.IsNullOrEmpty(_status)) { <p class="status">@_status</p> }
            <p class="hint">Requires a WebGPU browser (Chrome/Edge). First model use downloads once, then it's cached.</p>
        </div>
    }
    else
    {
        <div class="transcript" @ref="_scrollRef">
            @if (_messages.Count == 0 && !_busy)
            {
                <div class="empty">
                    <p>Try: <button class="chip" @onclick="@(() => SendPreset("Explain how you run entirely inside my browser."))">how do you work?</button>
                       <button class="chip" @onclick="@(() => SendPreset("Draw me a picture of a lighthouse in a storm."))">draw a lighthouse 🎨</button>
                       <button class="chip" @onclick="@(() => SendPreset("/model"))">/model</button></p>
                </div>
            }
            @foreach (var msg in _messages)
            {
                <div class="msg @msg.Role">
                    <div class="who">@(msg.Role == "user" ? "You" : msg.Role == "system" ? "System" : "Assistant")</div>
                    <div class="text">@RenderRich(msg.Text)</div>
                    @foreach (var img in msg.Images)
                    {
                        <figure class="genimg">
                            <img src="@img.Url" alt="@img.Label" />
                            <figcaption>
                                <span>@img.Label</span>
                                <a class="dl" href="@img.Url" download="@($"{Sanitize(img.Label)}.png")">⬇ Download</a>
                            </figcaption>
                        </figure>
                    }
                    @if (msg.Ms > 0)
                    {
                        <div class="meta">@($"{msg.Ms / 1000.0:F1}s") @(msg.TokPerSec > 0 ? $"· {msg.TokPerSec:F1} tok/s" : "") @(msg.Truncated ? "· length limit" : "")</div>
                    }
                </div>
            }
            @if (_busy)
            {
                <div class="msg assistant">
                    <div class="who">Assistant</div>
                    <div class="text">@RenderRich(_streaming)<span class="caret">▋</span></div>
                    @if (!string.IsNullOrEmpty(_busyNote)) { <div class="meta">@_busyNote</div> }
                </div>
            }
        </div>

        <div class="composer">
            <textarea @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown" rows="1"
                      placeholder="Message — or /model, /image-model, or ask for a picture…" disabled="@_busy"></textarea>
            <button class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">Send</button>
            <button class="primary" @onclick="DirectImageFromPromptAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))" title="Generate an image directly from your prompt (bypass the LLM)">🖼️</button>
            <button class="primary" @onclick="TestDirectImageAsync" disabled="@_busy" title="IMGTEST: direct SD-Turbo, fixed lighthouse prompt (bypass LLM)">🔬</button>
        </div>
        <footer class="sdai-ftr">
            <span>@_status</span>
            @if (!string.IsNullOrEmpty(_storageLine))
            {
                <span class="storage">@_storageLine <button class="linkbtn" @onclick="ClearStorageAsync" disabled="@_busy">clear</button></span>
            }
        </footer>
    }
</div>

<style>
    :root { color-scheme: dark; }
    body { margin: 0; background: #0b0e14; }
    .sdai { max-width: 880px; margin: 0 auto; padding: 0 1rem 1rem; font-family: 'Segoe UI', system-ui, sans-serif; color: #d6dbe4; display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }
    .sdai-hdr { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid #1d2430; flex-wrap: wrap; }
    .brand { display: flex; gap: .7rem; align-items: center; }
    .logo { font-size: 1.9rem; }
    .brand h1 { margin: 0; font-size: 1.15rem; letter-spacing: .4px; }
    .brand p { margin: 0; font-size: .74rem; color: #7c8798; }
    .pickers { display: flex; gap: .9rem; }
    .pickers label { font-size: .68rem; color: #7c8798; display: flex; flex-direction: column; gap: .15rem; }
    select { background: #131926; color: #d6dbe4; border: 1px solid #273043; border-radius: 6px; padding: .3rem .45rem; font-size: .8rem; }
    .gear { background: #131926; border: 1px solid #273043; border-radius: 8px; color: #9fb0c8; font-size: 1rem; padding: .28rem .5rem; cursor: pointer; align-self: flex-end; line-height: 1; }
    .gear.on { border-color: #7c3aed; background: #1c1730; }
    .settings { border: 1px solid #273043; background: #0f1420; border-radius: 12px; padding: .85rem 1rem; margin-top: .7rem; display: flex; flex-direction: column; gap: .9rem; }
    .settings .setlbl { display: flex; flex-direction: column; gap: .25rem; font-size: .74rem; color: #9fb0c8; }
    .settings .setlbl b { color: #d6dbe4; font-weight: 600; }
    .sethint { font-size: .66rem; color: #6a7688; line-height: 1.4; font-weight: 400; }
    .sysbox { width: 100%; box-sizing: border-box; resize: vertical; background: #131926; border: 1px solid #273043; color: #d6dbe4; border-radius: 8px; padding: .5rem .6rem; font-size: .82rem; font-family: inherit; line-height: 1.5; margin-top: .35rem; }
    .setactions { display: flex; justify-content: space-between; align-items: center; margin-top: .3rem; }
    .setcount { font-size: .64rem; color: #5d6879; }
    .setgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .setgrid input[type=range] { width: 100%; accent-color: #7c3aed; margin-top: .2rem; }
    @@media (max-width: 560px) { .setgrid { grid-template-columns: 1fr; } }
    .hero { margin: auto; text-align: center; max-width: 520px; }
    .hero h2 { font-size: 1.5rem; margin-bottom: .4rem; }
    .hero p { color: #97a1b2; line-height: 1.55; }
    .status { color: #56c98d; font-size: .82rem; white-space: pre-wrap; }
    .hint { font-size: .72rem; color: #5d6879; }
    button.primary { background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; border: none; border-radius: 8px; padding: .55rem 1.15rem; font-size: .9rem; cursor: pointer; }
    button.primary:disabled { opacity: .5; cursor: default; }
    button.primary.big { padding: .8rem 1.8rem; font-size: 1.05rem; }
    .transcript { flex: 1; overflow-y: auto; padding: 1rem 0; display: flex; flex-direction: column; gap: .9rem; }
    .empty { margin: auto; color: #5d6879; }
    .chip { background: #131926; border: 1px solid #273043; color: #9fb0c8; border-radius: 999px; padding: .3rem .8rem; margin: 0 .2rem; cursor: pointer; font-size: .78rem; }
    .msg { max-width: 88%; }
    .msg.user { align-self: flex-end; }
    .msg .who { font-size: .68rem; color: #7c8798; margin-bottom: .18rem; }
    .msg.user .who { text-align: right; }
    .msg .text { background: #131926; border: 1px solid #1d2430; border-radius: 12px; padding: .6rem .8rem; white-space: pre-wrap; line-height: 1.5; font-size: .92rem; overflow-wrap: anywhere; }
    .msg.user .text { background: #1b2f55; border-color: #27406e; }
    .msg.system .text { background: #241a33; border-color: #3a2d52; font-size: .82rem; }
    .msg .text :is(code) { background: #0b0e14; border-radius: 4px; padding: .05rem .3rem; font-size: .85em; }
    .msg .text pre { background: #0b0e14; border: 1px solid #1d2430; border-radius: 8px; padding: .6rem; overflow-x: auto; }
    .meta { font-size: .66rem; color: #5d6879; margin: .25rem .2rem 0; }
    .genimg { margin: .5rem 0 0; }
    .genimg img { max-width: 100%; border-radius: 12px; border: 1px solid #273043; display: block; }
    .genimg figcaption { display: flex; justify-content: space-between; font-size: .7rem; color: #7c8798; margin-top: .25rem; }
    .genimg .dl { color: #6ea8ff; text-decoration: none; }
    .caret { animation: blink 1s step-start infinite; }
    @@keyframes blink { 50% { opacity: 0; } }
    .composer { display: flex; gap: .5rem; padding-top: .6rem; border-top: 1px solid #1d2430; }
    .composer textarea { flex: 1; resize: none; background: #131926; border: 1px solid #273043; color: #d6dbe4; border-radius: 10px; padding: .55rem .7rem; font-size: .92rem; font-family: inherit; }
    .sdai-ftr { font-size: .68rem; color: #4d5866; padding-top: .4rem; min-height: 1em; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .linkbtn { background: none; border: none; color: #6ea8ff; cursor: pointer; font-size: inherit; padding: 0; text-decoration: underline; }
</style>
