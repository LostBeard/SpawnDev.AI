@page "/"
@using SpawnDev.AI
@using SpawnDev.AI.Server
@using SpawnDev.BlazorJS
@inject AiWorkerClient Ai
@inject BlazorJSRuntime JS

<PageTitle>SpawnDev.AI - in-browser Ollama</PageTitle>

<div style="max-width:820px;margin:0 auto;padding:1rem;font-family:system-ui,sans-serif;">
    <h1 style="font-size:1.4rem;">SpawnDev.AI <span style="font-size:.8rem;background:#334;color:#fff;border-radius:4px;padding:2px 8px;">Ollama in a shared worker</span></h1>
    <p style="color:#666;font-size:.9rem;">
        The model server runs in a <b>shared web worker</b> on WebGPU - every tab talks to the same
        resident model over the Ollama protocol. Weights stream P2P from the SpawnDev hub and cache
        in your browser.
    </p>

    @if (!_ready)
    {
        <button @onclick="StartAsync" disabled="@_starting" style="padding:.5rem 1.2rem;">
            @(_starting ? "Starting worker + GPU…" : "Start the AI server")
        </button>
        <pre style="color:#888;font-size:.8rem;">@_status</pre>
    }
    else
    {
        <p style="font-size:.8rem;color:#484;">@_status</p>
        <div style="display:flex;gap:.5rem;align-items:center;">
            <select @bind="_model" disabled="@_busy">
                @foreach (var m in _models) { <option value="@m">@m</option> }
            </select>
            <span style="font-size:.8rem;color:#888;">first request loads the model (downloads once, then browser-cached)</span>
        </div>

        <div style="border:1px solid #ccc;border-radius:6px;min-height:200px;max-height:420px;overflow-y:auto;padding: .8rem;margin:1rem 0;" @ref="_scrollRef">
            @foreach (var (role, text) in _messages)
            {
                <div style="margin-bottom:.8rem;">
                    <b>@(role == "user" ? "You" : "Assistant")</b>
                    <div style="white-space:pre-wrap;">@text</div>
                </div>
            }
            @if (_busy)
            {
                <div><b>Assistant</b><div style="white-space:pre-wrap;">@_streaming<span>▋</span></div></div>
            }
        </div>

        <div style="display:flex;gap:.5rem;">
            <input style="flex:1;padding:.4rem;" @bind="_input" @bind:event="oninput"
                   @onkeydown="@(e => e.Key == "Enter" ? SendAsync() : Task.CompletedTask)"
                   placeholder="Send a message…" disabled="@_busy" />
            <button @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">Send</button>
        </div>
    }
</div>

@code {
    bool _ready, _starting, _busy;
    string _status = "";
    string _model = "qwen2.5:0.5b-instruct-q8_0";
    readonly List<string> _models = new();
    readonly List<(string Role, string Text)> _messages = new();
    string _input = "", _streaming = "";
    ElementReference _scrollRef;

    async Task StartAsync()
    {
        _starting = true;
        _status = "Attaching shared worker, requesting WebGPU…";
        StateHasChanged();
        try
        {
            _status = await Ai.InitAsync();
            var tags = await Ai.RequestJsonAsync("GET", "/api/tags");
            using var doc = System.Text.Json.JsonDocument.Parse(tags);
            _models.Clear();
            foreach (var m in doc.RootElement.GetProperty("models").EnumerateArray())
                _models.Add(m.GetProperty("name").GetString()!);
            if (_models.Count > 0 && !_models.Contains(_model)) _model = _models[0];
            _ready = true;
        }
        catch (Exception ex) { _status = $"Failed: {ex.Message}"; }
        finally { _starting = false; StateHasChanged(); }
    }

    async Task SendAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_input)) return;
        var question = _input.Trim();
        _input = "";
        _messages.Add(("user", question));
        _busy = true;
        _streaming = "";
        StateHasChanged();

        // Perf lessons from the ML /ai-chat campaign baked in: renders throttled to ~10Hz (a render
        // per token throttled decode to word-per-second), scroll at 2Hz (forced layout), and the
        // decode itself runs in the WORKER - the UI thread only receives deltas.
        var renderClock = System.Diagnostics.Stopwatch.StartNew();
        var scrollClock = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var convo = _messages.Select(m => new AiChatMessage(m.Role, m.Text)).ToList();
            var doneReason = await Ai.ChatStreamAsync(_model, convo,
                new AiGenerationOptions { MaxOutputTokens = 256, Strategy = "top_p", Temperature = 0.7f, TopP = 0.9f },
                onDelta: delta =>
                {
                    _streaming += delta;
                    if (renderClock.ElapsedMilliseconds >= 100)
                    {
                        renderClock.Restart();
                        bool doScroll = scrollClock.ElapsedMilliseconds >= 500;
                        if (doScroll) scrollClock.Restart();
                        InvokeAsync(async () => { StateHasChanged(); if (doScroll) await ScrollToBottom(); });
                    }
                });
            var answer = _streaming;
            if (doneReason == "length") answer += " […length limit reached]";
            _messages.Add(("assistant", answer));
        }
        catch (Exception ex) { _messages.Add(("assistant", $"[error: {ex.Message}]")); }
        finally
        {
            _streaming = "";
            _busy = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    Task ScrollToBottom()
    {
        try { using var el = new SpawnDev.BlazorJS.JSObjects.HTMLElement(_scrollRef); el.ScrollTop = el.ScrollHeight; }
        catch { /* transcript not mounted yet */ }
        return Task.CompletedTask;
    }
}
