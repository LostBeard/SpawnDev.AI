@using SpawnDev.AI.Server
@using SpawnDev.SpawnJS
@inject AiWorkerClient Ai
@inject VoiceLibrary Voices
@inject HttpClient Http
@inject SpawnJSRuntime JS

<div class="sdai">
    <header class="sdai-hdr">
        <div class="brand">
            <span class="logo">🖖</span>
            <div>
                <h1>SpawnDev.AI</h1>
                <p>LLM chat + image generation, 100% on your GPU. Nothing leaves your device.</p>
            </div>
        </div>
        @if (_ready)
        {
            <div class="pickers">
                <label>
                    Chat model
                    @* A tick means it is on this device; a size means choosing it starts that download. *@
                    <select @bind="_model" disabled="@_busy">
                        @foreach (var m in _models)
                        {
                            var choice = ChoiceFor(m);
                            <option value="@m">
                                @(choice == null ? m
                                  : IsApproved(m) ? $"✓ {m}"
                                  : $"⬇ {m} ({FormatSize(choice.SizeBytes)})")
                            </option>
                        }
                    </select>
                </label>
                <label>
                    Image model
                    <select @bind="_imageModel" disabled="@_busy">
                        @foreach (var (name, _) in _imageModels)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </label>
                <button class="gear @(_showSettings ? "on" : "")" @onclick="ToggleSettings" title="Agent settings (system prompt, temperature)">⚙️</button>
                @* GROUP CHAT. Characters the user made - each with its own persona, model and voice - talk
                   to each other and to the user inside a shared scene. *@
                @* MODELS. Sizes and "already downloaded" live here, because a name in a dropdown cannot
                   tell anyone that picking it costs 6.9 GB. *@
                <button class="gear @(_showModels ? "on" : "")" @onclick="() => { _showModels = !_showModels; }"
                        title="Choose a model - sizes, and what is already downloaded">📦</button>
                <button class="gear @(_showRoom ? "on" : "")" @onclick="() => { _showRoom = !_showRoom; }"
                        title="Group chat: characters, scene, and who is in the room">
                    @(RoomActive ? $"🎭 {_room.Agents.Count}" : "🎭")
                </button>
            </div>
        }
    </header>

    @if (_ready && _showSettings)
    {
        <div class="settings">
            <div class="setrow">
                <label class="setlbl">
                    System prompt
                    <span class="sethint">Sets the assistant's persona and behavior. Image requests work regardless — the server auto-runs the image tool on any clear "draw / generate a picture" request.</span>
                </label>
                <textarea class="sysbox" @bind="_systemPrompt" @bind:event="oninput" rows="5" disabled="@_busy"
                          placeholder="(empty = no system prompt — a bare model)"></textarea>
                <div class="setactions">
                    <button class="linkbtn" @onclick="ResetSystemPrompt" disabled="@_busy">Reset to default</button>
                    <span class="setcount">@_systemPrompt.Length chars</span>
                </div>
            </div>
            <div class="setgrid">
                <label class="setlbl">
                    Temperature <b>@_temperature.ToString("0.00")</b>
                    <input type="range" min="0" max="1.5" step="0.05" @bind="_temperature" @bind:event="oninput" disabled="@_busy" />
                    <span class="sethint">0 = focused/deterministic · higher = more creative &amp; varied</span>
                </label>
                <label class="setlbl">
                    Max response tokens <b>@_maxTokens</b>
                    <input type="range" min="64" max="2048" step="64" @bind="_maxTokens" @bind:event="oninput" disabled="@_busy" />
                    <span class="sethint">Upper bound on reply length</span>
                </label>
            </div>
        </div>
    }

    @* ── MODELS ──
       🔴 Nothing here downloads until a button is pressed. Each row states what the model is for and what
       it costs, and whether this device already has it - read from the torrent client, so it stays true
       after the browser evicts one. *@
    @if (_ready && _showModels)
    {
        <div class="settings models">
            <div class="setrow">
                <label class="setlbl">
                    Models
                    <span class="sethint">
                        Weights stream from the SpawnDev hub and are cached in your browser. Large downloads
                        happen only when you ask for them, and only once.
                    </span>
                </label>
                @if (_catalogue.Count == 0)
                {
                    <p class="sethint">
                        The catalogue is unavailable, so sizes cannot be shown. Models will still load on
                        demand - which means a large one may download without warning.
                    </p>
                }
                <div class="modellist">
                    @foreach (var choice in _catalogue)
                    {
                        <div class="modelrow @(_model == choice.Name ? "current" : "") @(IsApproved(choice.Name) ? "here" : "")">
                            <div class="modelhead">
                                <b>@choice.Name</b>
                                @* The size is always shown. "Approved" means the user already agreed to
                                   fetch it, which is what the app can actually know - not whether the
                                   bytes are still in the browser cache. *@
                                @* Size always, plus whether it was agreed to, plus how much is already
                                   here. The cached figure is INFORMATION only - it never reaches 100% for
                                   a lazy-hash torrent, so nothing is decided on it. *@
                                <span class="modelsize">
                                    @FormatSize(choice.SizeBytes)@(IsApproved(choice.Name) ? " · approved" : "")@CachedLabel(choice.Name)
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(choice.Description))
                            {
                                <div class="sethint">@choice.Description</div>
                            }
                            <div class="modelactions">
                                @if (_downloadingModel == choice.Name)
                                {
                                    <span class="sethint">Fetching… the page stays usable.</span>
                                }
                                else if (IsApproved(choice.Name))
                                {
                                    <button class="chip" disabled="@(_downloadingModel.Length > 0)"
                                            @onclick="() => DownloadAndLoadAsync(choice.Name)">
                                        @(_model == choice.Name ? "Reload" : "Use this model")
                                    </button>
                                }
                                else
                                {
                                    <button class="chip download" disabled="@(_downloadingModel.Length > 0)"
                                            @onclick="() => DownloadAndLoadAsync(choice.Name)">
                                        ⬇ Download &amp; load (@FormatSize(choice.SizeBytes))
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── GROUP CHAT ─────────────────────────────────────────
       Characters are saved in OPFS and survive a reload. The SCENE belongs to the room, not to any
       character: it is the shared setting every member is handed verbatim, which is what lets several
       characters role-play ONE situation together instead of separately answering the same question. *@
    @if (_ready && _showRoom)
    {
        <div class="settings room">
            <div class="setrow">
                <label class="setlbl">
                    The scene
                    <span class="sethint">
                        Where everyone is and what is going on. Every character is told this, word for word.
                        Leave it empty for an ordinary conversation.
                    </span>
                </label>
                <textarea class="sysbox" @bind="_room.Scene" @bind:event="oninput" rows="3" disabled="@_busy"
                          placeholder="e.g. The derelict colony of Copper-9, in the dark, after the lights failed."></textarea>
                <div class="setactions">
                    <label class="setlbl inline">
                        Replies per round <b>@_room.MaxAgentTurnsPerRound</b>
                        <input type="range" min="1" max="8" step="1" @bind="_room.MaxAgentTurnsPerRound"
                               @bind:event="oninput" disabled="@_busy" />
                        <span class="sethint">
                            How many character replies one message triggers. This is the stop: characters
                            given each other&#39;s replies will otherwise answer each other forever.
                        </span>
                    </label>
                </div>
            </div>

            @* THE PHYSICAL ROBOT. Only one character can hold it, and the page has to be served over
               plain HTTP to reach it at all - the daemon speaks HTTP on the LAN, so an HTTPS page is
               blocked as mixed content and the failure looks like an unreachable robot. Say so up front. *@
            <div class="setrow">
                <label class="setlbl">
                    Reachy Mini
                    <span class="sethint">
                        Give a character the "Reachy Mini" body and it acts out its *actions* on the real
                        robot. Everyone else in the scene is drawn on screen.
                    </span>
                </label>
                @if (ReachyDriver.MixedContentWarning(JS.Get<string?>("location.origin")) is { } warn)
                {
                    <p class="sethint warn">@warn</p>
                }
                <div class="setactions">
                    <input class="voice-name" placeholder="robot address, e.g. 192.168.1.170"
                           @bind="_robotAddress" disabled="@(_robotBusy || Robot.IsConnected)" />
                    <button class="chip" @onclick="ToggleRobotAsync" disabled="@_robotBusy">
                        @(_robotBusy ? "…" : Robot.IsConnected ? "Park & disconnect" : "Connect")
                    </button>
                </div>
                <span class="sethint">@Robot.Status</span>
            </div>

            <div class="setrow">
                <label class="setlbl">
                    Characters
                    <span class="sethint">Click a name to bring them into the room, or send them out again.</span>
                </label>
                @if (_characters.Count == 0)
                {
                    <p class="sethint">None yet — make one below.</p>
                }
                <div class="charlist">
                    @foreach (var c in _characters)
                    {
                        <span class="charchip @(IsInRoom(c.Id) ? "in" : "")">
                            <button class="chip" @onclick="() => ToggleInRoom(c)" disabled="@_busy"
                                    title="@(IsInRoom(c.Id) ? $"Take {c.Name} out of the room" : $"Bring {c.Name} into the room")">
                                @(IsInRoom(c.Id) ? "🎭" : "＋") @c.Name
                                @if (CharacterLibrary.ResolveVoice(c, _savedVoices) != null)
                                {
                                    <span class="charvoice">🗣️</span>
                                }
                            </button>
                            <button class="chip tiny" @onclick="() => EditCharacter(c)" title="@($"Edit {c.Name}")">✎</button>
                            <button class="chip tiny" @onclick="() => DeleteCharacterAsync(c.Id)"
                                    title="@($"Delete {c.Name} from this device")">🗑️</button>
                        </span>
                    }
                </div>
            </div>

            <div class="setrow">
                <label class="setlbl">
                    @(string.IsNullOrEmpty(_editingCharId) ? "New character" : $"Editing {_charName}")
                </label>
                <div class="setgrid">
                    <label class="setlbl">
                        Name
                        <input class="voice-name wide" @bind="_charName" disabled="@_savingCharacter"
                               placeholder="e.g. Uzi, N, Doll" />
                    </label>
                    <label class="setlbl">
                        Model
                        <select @bind="_charModel" disabled="@_savingCharacter">
                            <option value="">(the room&#39;s model — @_model)</option>
                            @foreach (var m in _models)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                        <span class="sethint">
                            Only one model stays resident, so characters on different models make the room
                            reload one per turn. The same model for everyone is much faster.
                        </span>
                    </label>
                    <label class="setlbl">
                        Body
                        <select @bind="_charAvatar" disabled="@_savingCharacter">
                            <option value="@AvatarKind.None">(none - text and voice only)</option>
                            <option value="@AvatarKind.Screen">On screen</option>
                            <option value="@AvatarKind.Reachy">Reachy Mini (the robot)</option>
                        </select>
                        <span class="sethint">
                            What acts out this character's *actions*. There is only one physical robot, so
                            if two characters ask for it the first one in the room keeps it and the other
                            is drawn on screen.
                        </span>
                    </label>
                    <label class="setlbl">
                        How animated <b>@_charMotionScale.ToString("0.0")x</b>
                        <input type="range" min="0.3" max="1.6" step="0.1" @bind="_charMotionScale"
                               @bind:event="oninput" disabled="@_savingCharacter" />
                        <span class="sethint">
                            Scales every gesture. The same written action reads as a twitch from one
                            character and a whole-body reaction from another.
                        </span>
                    </label>
                    <label class="setlbl">
                        Voice
                        <select @bind="_charVoiceId" disabled="@_savingCharacter">
                            <option value="">(no voice — text only)</option>
                            @foreach (var v in _savedVoices)
                            {
                                <option value="@v.Id">🗣️ @v.DisplayName</option>
                            }
                            @foreach (var v in BundledVoices.All)
                            {
                                <option value="@v.Id" title="@($"{v.Licence} — {v.Attribution}")">🎧 @v.DisplayName</option>
                            }
                        </select>
                    </label>
                </div>
                @* TOOLS. Per character, because these act on the world - and a tool a character is not
                   handed is one it cannot be talked into calling. *@
                @if (_serverToolNames.Count > 0)
                {
                    <label class="setlbl">
                        What they can do
                        <span class="sethint">
                            ⚠️ Small models over-call tools. MEASURED: asked "what colour is a ripe
                            banana?" with tools available, qwen2.5-0.5b called the image generator and
                            narrated that instead of answering. Grant these to a capable model, or to a
                            character whose job is actually to use them.
                        </span>
                    </label>
                    <div class="charlist">
                        @foreach (var tool in _serverToolNames)
                        {
                            <label class="toolgrant @(_charTools.Contains(tool) ? "on" : "")">
                                <input type="checkbox" checked="@_charTools.Contains(tool)"
                                       disabled="@_savingCharacter"
                                       @onchange="e => ToggleCharTool(tool, (bool)(e.Value ?? false))" />
                                @tool
                            </label>
                        }
                    </div>
                }
                <label class="setlbl">
                    How they act
                    <span class="sethint">Written into their system turn, exactly as you type it.</span>
                </label>
                <textarea class="sysbox" @bind="_charPersona" rows="3" disabled="@_savingCharacter"
                          placeholder="e.g. You are Uzi Doorman: sardonic, defensive, and secretly loyal. You speak in short, cutting sentences."></textarea>
                <div class="setactions">
                    <button class="primary" @onclick="SaveCharacterAsync"
                            disabled="@(_savingCharacter || string.IsNullOrWhiteSpace(_charName))">
                        @(_savingCharacter ? "Saving…" : string.IsNullOrEmpty(_editingCharId) ? "Create" : "Save changes")
                    </button>
                    @if (!string.IsNullOrEmpty(_editingCharId))
                    {
                        <button class="linkbtn" @onclick="NewCharacter" disabled="@_savingCharacter">New character</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (!_ready)
    {
        <div class="hero">
            <h2>Your browser is the AI server</h2>
            <p>
                One click starts a shared-worker model server on WebGPU. Weights stream peer-to-peer
                and cache in your browser — every tab shares the same resident model. Ask for a
                picture and the chat model will paint one with the on-device diffusion model.
            </p>
            @* Starting the server IS the agreement for the model it will run - the size is on the
               button, so nothing large is ever fetched without having been named first. Every OTHER model
               is agreed to separately in the model panel. *@
            <button class="primary big" @onclick="StartAsync" disabled="@_starting">
                @(_starting ? "Starting worker + WebGPU…"
                  : SizeOfModel(_model) is > 0 and var sz ? $"Start the AI server ({FormatSize(sz)} model)"
                  : "Start the AI server")
            </button>
            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="status">@_status</p>
            }
            <p class="hint">Requires a WebGPU browser (Chrome/Edge). First model use downloads once, then it's cached.</p>
        </div>
    }
    else
    {
        @* THE STAGE. Characters with a body stand here, above the conversation, and act out what they
           wrote while they say it. Drawn only when somebody actually has a body - an empty strip above a
           normal chat would be clutter. *@
        @if (RoomActive && EmbodiedAgents().Any())
        {
            <div class="stage">
                @foreach (var (agent, kind) in EmbodiedAgents())
                {
                    <div class="stage-slot @(kind == AvatarKind.Reachy ? "robot" : "")"
                         title="@(kind == AvatarKind.Reachy ? $"{agent.Name} is driving Reachy Mini" : agent.Name)">
                        <ReachyAvatar Name="@agent.Name"
                                      Action="@ActionFor(agent.Id)"
                                      Speaking="@(_speakingAgentId == agent.Id)" />
                        @if (kind == AvatarKind.Reachy)
                        {
                            <span class="robot-badge" title="Driving the physical robot">🤖</span>
                        }
                    </div>
                }
            </div>
        }

        <div class="transcript" @ref="_scrollRef">
            @if (_messages.Count == 0 && !_busy)
            {
                <div class="empty">
                    <p>
                        Try: <button class="chip" @onclick="@(() => SendPreset("Explain how you run entirely inside my browser."))">how do you work?</button>
                        <button class="chip" @onclick="@(() => SendPreset("Draw me a picture of a lighthouse in a storm."))">draw a lighthouse 🎨</button>
                        <button class="chip" @onclick="@(() => SendPreset("What is SpawnDev.BlazorJS and who is on the crew?"))">about SpawnDev 🧬</button>
                        <button class="chip" @onclick="@(() => SendPreset("/model"))">/model</button>
                    </p>
                </div>
            }
            @foreach (var msg in _messages)
            {
                <div class="msg @msg.Role">
                    <div class="who">@(!string.IsNullOrEmpty(msg.Who) ? msg.Who
                                        : msg.Role == "user" ? "You" : msg.Role == "system" ? "System" : "Assistant")</div>
                    <div class="text">@RenderRich(msg.Text)</div>
                    @foreach (var img in msg.Images)
                    {
                        <figure class="genimg">
                            <img src="@img.Url" alt="@img.Label" />
                            <figcaption>
                                <span>@img.Label</span>
                                <a class="dl" href="@img.Url" download="@($"{Sanitize(img.Label)}.png")">⬇ Download</a>
                            </figcaption>
                        </figure>
                    }
                    @if (msg.Ms > 0)
                    {
                        <div class="meta">@($"{msg.Ms / 1000.0:F1}s") @(msg.TokPerSec > 0 ? $"· {msg.TokPerSec:F1} tok/s" : "") @(msg.Truncated ? "· length limit" : "") @(msg.Stopped ? "· stopped" : "")</div>
                    }
                </div>
            }
            @if (_busy)
            {
                <div class="msg assistant">
                    <div class="who">@(string.IsNullOrEmpty(_streamingWho) ? "Assistant" : _streamingWho)</div>
                    <div class="text">@RenderRich(_streaming)<span class="caret">▋</span></div>
                    @if (!string.IsNullOrEmpty(_busyNote))
                    {
                        <div class="meta">@_busyNote</div>
                    }
                </div>
            }
            @* ⚠️ Speaking happens AFTER the turn's finally, so `_busy` is false and the bubble above is not
               in the DOM - which meant the entire spoken reply had NO indicator at all. The first one pays
               a cold ZipVoice load (two int8 graphs plus a 54 MB vocoder out of a remote archive): MEASURED
               88.7 s, during which the page showed a finished text answer and nothing else. That is
               indistinguishable from an assistant that simply never speaks, which is exactly how it was
               reported. *@
            @if (_speaking)
            {
                <div class="msg assistant speaking">
                    <div class="who">Assistant</div>
                    <div class="text">🔊 @(string.IsNullOrEmpty(_status) ? "Speaking…" : _status)</div>
                </div>
            }
        </div>

        <div class="composer">
            <textarea @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown" rows="1"
                      placeholder="Message — or /model, /image-model, or ask for a picture…" disabled="@_busy"></textarea>
            <button class="primary @(_listening ? "listening" : "")" @onclick="ToggleMicAsync" disabled="@_busy"
                    title="@(_listening ? "Stop and transcribe" : "Speak your message")">
                @(_listening ? $"⏹️ {_listenSeconds:F1}s" : "🎤")
            </button>
            @* Hands-free: listen, send, and speak the reply back in your own voice, then listen again.
               NOT disabled while busy - stopping a runaway loop is exactly what you want mid-turn. *@
            <button class="primary @(_handsFree ? "listening" : "")" @onclick="ToggleHandsFreeAsync"
                    title="@(_handsFree ? "Stop hands-free conversation" : "Hands-free: talk, and it talks back in your voice")">
                @(_handsFree ? "🛑 Hands-free" : "💬🔊")
            </button>
            @* STOP SPEAKING. The user has read the reply and wants to answer - waiting out the voice is the
               single most irritating thing a talking app does. Cancels the chunk loop as well as the audio,
               or the next sentence would render and start playing a moment after being told to stop. *@
            @if (_speaking)
            {
                <button class="primary stop" @onclick="StopSpeaking"
                        title="Stop speaking so you can answer">■🔊</button>
            }
            @* SAVED VOICES. Without these the reply is cloned from the user's LAST TURN on every single
               reply - re-sending the reference PCM over the worker, making the engine re-derive prompt
               features that never change, and cloning from the recogniser's transcript rather than a clean
               one. A saved voice is derived once, persists in OPFS across reloads, and is chosen here. *@
            <select class="voice-picker" disabled="@_savingVoice"
                    title="Which voice replies are spoken in"
                    @onchange="e => SelectVoiceAsync(e.Value?.ToString() ?? string.Empty)">
                <option value="" selected="@string.IsNullOrEmpty(_voiceId)">🗣️ Your last turn</option>
                @foreach (var v in _savedVoices)
                {
                    <option value="@v.Id" selected="@(_voiceId == v.Id)">🗣️ @v.DisplayName</option>
                }
                @* Included voices need nothing recorded first, so the picker is useful on a fresh install.
                   Each carries its licence in BundledVoices.cs. *@
                @foreach (var v in BundledVoices.All)
                {
                    <option value="@v.Id" selected="@(_voiceId == v.Id)" title="@($"{v.Licence} — {v.Attribution}")">
                        🎧 @v.DisplayName
                    </option>
                }
            </select>
            @if (_lastHeardSamples != null && _lastHeardSamples.Length > 0)
            {
                <button class="primary" disabled="@_savingVoice"
                        @onclick='() => SaveCurrentVoiceAsync(_newVoiceName)'
                        title="Keep the voice you just spoke in, so replies stop re-cloning it every turn">
                    @(_savingVoice ? "…" : "💾🗣️")
                </button>
                <input class="voice-name" placeholder="name this voice" @bind="_newVoiceName"
                       disabled="@_savingVoice" title="Whose voice is this? e.g. Nikki, Aubs" />
            }
            @if (!string.IsNullOrEmpty(_voiceId))
            {
                <button class="primary" @onclick="() => DeleteVoiceAsync(_voiceId)"
                        title="@($"Delete the saved voice {_voiceName} from this device")">🗑️🗣️</button>
            }
            @* Stop REPLACES Send while a generation is in flight, and is bound to _generationCts rather
               than _busy: _busy is also true while transcribing or generating an image, where there is
               no chat generation to cancel and the button would be dead. *@
            @if (_generationCts != null)
            {
                <button class="primary stop" @onclick="StopGeneration"
                        title="Stop generating. The reply so far is kept.">■ Stop</button>
            }
            else
            {
                <button class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">Send</button>
            }
            <button class="primary" @onclick="DirectImageFromPromptAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))" title="Generate an image directly from your prompt (bypass the LLM)">🖼️</button>
            <button class="primary" @onclick="TestDirectImageAsync" disabled="@_busy" title="IMGTEST: direct SD-Turbo, fixed lighthouse prompt (bypass LLM)">🔬</button>
        </div>
        @* Two bars, because "it is not hearing me" has two independent halves and one bar cannot
           separate them. INPUT is the microphone level after conversion to 16 kHz - the signal actually
           handed to the detector, not the device's raw level, so a rate conversion that destroys the
           audio shows up here as a dead bar while the room is loud. SPEECH is what the detector makes of
           it. Input moving with speech flat is a threshold or model problem; input flat is capture. *@
        @if (_listening)
        {
            <div class="levels">
                <div class="lvl-row">
                    <span class="lvl-label">input</span>
                    <div class="lvl-track"><div class="lvl-fill" style="width:@MicLevelPercent%"></div></div>
                    <span class="lvl-num">@_micPeak.ToString("F3")</span>
                </div>
                <div class="lvl-row">
                    <span class="lvl-label">speech</span>
                    <div class="lvl-track"><div class="lvl-fill @(_speechActive ? "speaking" : "")" style="width:@((int)(_speechProbability * 100))%"></div></div>
                    <span class="lvl-num">@_speechProbability.ToString("F2")</span>
                </div>
            </div>
        }
        <footer class="sdai-ftr">
            <span>@_status</span>
            @if (!string.IsNullOrEmpty(_storageLine))
            {
                <span class="storage">@_storageLine <button class="linkbtn" @onclick="ClearStorageAsync" disabled="@_busy">clear</button></span>
            }
        </footer>
    }
</div>

<style>
    :root {
        color-scheme: dark;
    }

    body {
        margin: 0;
        background: #0b0e14;
    }

    .sdai {
        max-width: 880px;
        margin: 0 auto;
