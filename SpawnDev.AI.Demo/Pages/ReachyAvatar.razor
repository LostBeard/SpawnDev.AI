@* An on-screen stand-in for Reachy Mini: a head that turns and tilts, and two antennae that carry most
   of the expression. Shaped like the robot ON PURPOSE - the same written action has to read the same way
   whether it is performed here or by the hardware, and there is only ever one of the hardware. *@

<div class="reachy @(Speaking ? "speaking" : "")" title="@Name">
    @* @key on the animated group is what makes the SAME action play twice in a row. A CSS animation does
       not restart when its class is re-applied to a node that already has it, so a character nodding twice
       would nod once and then stand still. Re-keying forces Blazor to swap the element, which restarts it. *@
    @* 🔴 DRAWN FROM THE REAL ROBOT, not from "a robot". Captain: "the avatars are currentyl very
       lackign in the AI demo... i want it to be a good representation of Reachy, at least the default
       one." What was here was an ellipse with two dots - it could have been any machine, and a stand-in
       that does not look like the hardware breaks the one promise this component makes, which is that a
       scene reads the same whether it plays on screen or on the robot.
       Reachy Mini's identity is four things, and all four are below: a domed cream SHELL, a wide dark
       VISOR carrying the eyes, two thin antennae with BALL TIPS, and a squat fabric-banded BASE. *@
    <svg viewBox="0 0 100 110" class="body" @key="_beat">
        <g class="act-@Action.ToString().ToLowerInvariant()">
            @* Antennae: the expressive part, since there are no arms and no eyebrows. Curved, not
               straight lines - on the real unit they are flexible stalks and they bend. *@
            <g class="antennae">
                <path class="ant left" d="M39 28 Q32 18 29 9" />
                <circle class="tip" cx="29" cy="8" r="3.2" />
                <path class="ant right" d="M61 28 Q68 18 71 9" />
                <circle class="tip" cx="71" cy="8" r="3.2" />
            </g>
            <g class="head">
                @* The shell: a cylinder with a domed top, flat-bottomed where it meets the neck. *@
                <path class="shell" d="M24 63 L24 45 Q24 23 50 23 Q76 23 76 45 L76 63 Q76 68 69 68 L31 68 Q24 68 24 63 Z" />
                @* One soft shade down the right, so the dome reads as round rather than as a sticker. *@
                <path class="shade" d="M61 24.5 Q76 30 76 45 L76 63 Q76 68 69 68 L61 68 Z" />
                @* The visor is the single most recognisable thing about this robot - a dark band across
                   the whole face with the cameras set into it, NOT two eyes floating on the shell. *@
                <rect class="visor" x="27" y="38" width="46" height="23" rx="11" />
                <circle class="eye" cx="40" cy="49.5" r="6.4" />
                <circle class="eye" cx="60" cy="49.5" r="6.4" />
                <circle class="pupil left" cx="40" cy="49.5" r="2.9" />
                <circle class="pupil right" cx="60" cy="49.5" r="2.9" />
            </g>
        </g>
        @* Base: fixed, so the head has something to move against. The band is the speaker/fabric
           section, which is most of what the body looks like from across a room. *@
        <g class="base">
            <rect class="neck" x="38" y="66" width="24" height="6" rx="3" />
            <path class="torso" d="M29 72 L71 72 L75 98 Q75 106 50 106 Q25 106 25 98 Z" />
            <path class="band" d="M27.2 86 L72.8 86 L75 98 Q75 106 50 106 Q25 106 25 98 Z" />
        </g>
    </svg>
    <div class="label">@Name</div>
</div>

@code {
    /// <summary>Who this body belongs to.</summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>
    /// The motion to perform. Setting it again replays it.
    /// </summary>
    /// <remarks>
    /// <c>SpawnDev.Reachy.Gesture</c> deliberately - the same vocabulary the physical robot performs, so a
    /// scene reads the same whether it plays here or on the hardware.
    /// </remarks>
    [Parameter] public SpawnDev.Reachy.Gesture Action { get; set; } = SpawnDev.Reachy.Gesture.None;

    /// <summary>True while this character is talking, for a subtle idle motion.</summary>
    [Parameter] public bool Speaking { get; set; }

    // Bumped whenever a motion is (re)assigned, purely to re-key the group and restart the animation.
    private int _beat;
    private SpawnDev.Reachy.Gesture _last = SpawnDev.Reachy.Gesture.None;

    protected override void OnParametersSet()
    {
        // Re-key on EVERY assignment, not only on a change of value: two nods in a row are two nods, and
        // comparing values would silently swallow the second one.
        if (Action != SpawnDev.Reachy.Gesture.None) _beat++;
        _last = Action;
    }
}

<style>
    .reachy {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: .15rem;
        width: 74px;
    }

    .reachy .body {
        width: 74px;
        height: 82px;
        overflow: visible;
    }

    /* ⚠️ CREAM, not dark. The old body was page-coloured and vanished into the panel behind it; the real
       robot is an off-white shell, and against this dark UI that is also what makes it legible at 74px. */
    .reachy .shell {
        fill: #ece7dd;
        stroke: #b9b0a0;
        stroke-width: 1.4;
    }

    .reachy .shade {
        fill: #d5cdbe;
        opacity: .85;
    }

    .reachy .visor {
        fill: #141924;
        stroke: #2b3344;
        stroke-width: 1.2;
    }

    .reachy .neck {
        fill: #b3aa9a;
    }

    .reachy .torso {
        fill: #e3ded3;
        stroke: #b9b0a0;
        stroke-width: 1.4;
    }

    .reachy .band {
        fill: #49556b;
    }

    /* The eye is the camera housing inside the visor; the pupil is the only lit thing on the robot, which
       is why it carries the app's accent and the blink. */
    .reachy .eye {
        fill: #2a3446;
    }

    .reachy .pupil {
        fill: #8b7cf6;
    }

    .reachy .ant {
        stroke: #6b7385;
        stroke-width: 2.2;
        stroke-linecap: round;
        fill: none;
    }

    .reachy .tip {
        fill: #8b7cf6;
    }

    .reachy .label {
        font-size: .62rem;
        color: #9fb0c8;
        max-width: 74px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* IT BLINKS, ALWAYS. Captain: "the avatar seem to be 100% static, never changes." Driving it from
       what the model writes fixes the turns; between turns there is nothing to perform and a face that
       holds perfectly still for minutes reads as a picture rather than a character. A blink is the
       cheapest possible sign of life - one property, no script, no work when off-screen - and it is
       deliberately slow and irregular-looking so it never competes with a real gesture.
       ⚠️ On the PUPIL, not the eye socket: scaling the socket would make the head look like it is
       deforming, while a pupil that narrows to a line reads as a blink at this size. */
    .reachy .pupil {
        animation: reachy-blink 7s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    @@keyframes reachy-blink {
        0%, 92%, 100% { transform: scaleY(1); }
        94%, 96% { transform: scaleY(.08); }
    }

    /* The second eye is a beat behind, which is what stops two circles pulsing in lockstep from reading
       as a flashing light rather than a blink.
       ⚠️ This was `.pupil:nth-of-type(2)` and MATCHED NOTHING. `nth-of-type` counts among siblings of the
       same ELEMENT type, and the second `circle` in that group is an `eye`, not a pupil - so the rule was
       asking for a circle that is both the 2nd circle and a pupil, which no element was. The offset never
       applied and both eyes blinked in lockstep the whole time. A class says what was meant. */
    .reachy .pupil.right {
        animation-delay: .06s;
    }

    /* A character that is talking breathes a little, so a silent room is visibly different from a
       speaking one even before any action fires. */
    .reachy.speaking .body {
        animation: reachy-breathe 1.6s ease-in-out infinite;
    }

    @@keyframes reachy-breathe {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-1.5px); }
    }

    /* Every motion is a one-shot on the group, and the transform origin is the neck so the head pivots
       where a head would rather than around the middle of the picture. */
    .reachy g[class^="act-"] {
        transform-origin: 50px 70px;
    }

    /* One class per SpawnDev.Reachy Gesture. Head motions animate the whole group; the antennae-led
       ones (perk, wiggle, droop) are further down, because on the real robot those are all stalks. */
    .act-nod { animation: reachy-nod 700ms ease-in-out; }
    .act-shake { animation: reachy-shake 700ms ease-in-out; }
    .act-tilt { animation: reachy-tilt 900ms ease-in-out; }
    .act-lookdown { animation: reachy-lookdown 900ms ease-in-out; }
    .act-lookup { animation: reachy-lookup 900ms ease-in-out; }
    .act-leanin { animation: reachy-leanin 800ms ease-in-out; }
    .act-turnbody { animation: reachy-turnbody 1400ms ease-in-out; }
    .act-bounce { animation: reachy-bounce 800ms ease-in-out; }
    .act-spin { animation: reachy-spin 1600ms ease-in-out; }

    @@keyframes reachy-nod {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        30% { transform: translateY(3px) rotate(6deg); }
        65% { transform: translateY(0) rotate(-2deg); }
    }

    @@keyframes reachy-shake {
        0%, 100% { transform: rotate(0deg); }
        20% { transform: rotate(9deg); }
        50% { transform: rotate(-9deg); }
        80% { transform: rotate(5deg); }
    }

    @@keyframes reachy-tilt {
        0%, 100% { transform: rotate(0deg); }
        35%, 70% { transform: rotate(-13deg); }
    }

    @@keyframes reachy-lookdown {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        40%, 65% { transform: translateY(4px) rotate(9deg); }
    }

    @@keyframes reachy-lookup {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        40%, 65% { transform: translateY(-4px) rotate(-9deg); }
    }

    /* Toward the viewer: there is no depth here, so it reads as a small scale-up plus a dip. */
    @@keyframes reachy-leanin {
        0%, 100% { transform: scale(1) translateY(0); }
        45%, 70% { transform: scale(1.07) translateY(2px); }
    }

    @@keyframes reachy-turnbody {
        0%, 100% { transform: translateX(0) rotate(0deg); }
        30% { transform: translateX(-7px) rotate(-8deg); }
        70% { transform: translateX(7px) rotate(8deg); }
    }

    @@keyframes reachy-bounce {
        0%, 100% { transform: translateY(0); }
        25% { transform: translateY(-5px); }
        50% { transform: translateY(1px); }
        75% { transform: translateY(-2px); }
    }

    /* A full turn - the robot rotates its torso, so the whole figure goes round. */
    @@keyframes reachy-spin {
        0% { transform: rotateY(0deg); }
        100% { transform: rotateY(360deg); }
    }

    /* Antennae carry perk/droop/wave: the head stays put and the expression is all in the stalks, which
       is exactly how Reachy Mini reads in person. */
    .act-perk .antennae { animation: reachy-perk 800ms ease-out; transform-origin: 50px 30px; }
    .act-droop .antennae { animation: reachy-droop 1100ms ease-in-out; transform-origin: 50px 30px; }
    .act-wiggle .antennae { animation: reachy-wiggle 900ms ease-in-out; transform-origin: 50px 30px; }

    @@keyframes reachy-perk {
        0%, 100% { transform: translateY(0) scaleY(1); }
        40% { transform: translateY(-4px) scaleY(1.18); }
    }

    @@keyframes reachy-droop {
        0%, 100% { transform: translateY(0) scaleY(1); }
        50% { transform: translateY(4px) scaleY(.72); }
    }

    @@keyframes reachy-wiggle {
        0%, 100% { transform: rotate(0deg); }
        20% { transform: rotate(-11deg); }
        45% { transform: rotate(11deg); }
        70% { transform: rotate(-7deg); }
    }

    /* Respect a stated preference for less motion - this is decoration, and a whole row of them moving at
       once is a lot. The character still speaks and still says what it did. */
    @@media (prefers-reduced-motion: reduce) {
        .reachy .body, .reachy g[class^="act-"], .reachy .antennae {
            animation: none !important;
        }
    }
</style>
