<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Disable compression (optional, based on use case) -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Disables the Hot Reload background client for WASM -->
		<WasmEnableHotReload>false</WasmEnableHotReload>

		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<CompressionEnabled>false</CompressionEnabled>

		<!-- 🔴 REQUIRED since SpawnDev.SpawnJS.WebWorkers 2.1.19. The Blazor SDK is used here only to compile
		     .razor; the app boots through SpawnJS + RazorRenderer from main.classic.js (wwwroot/index.html).
		     Without this the WebWorkers targets see the Blazor SDK, assume the Blazor JS runtime, and skip the
		     classic bundle: no main.classic.js is published, index.html's script 404s into the HTML fallback,
		     and the page dies on "SyntaxError: Unexpected token '<'" with nothing else in the console. -->
		<SpawnJSWebWorkersBlazor>false</SpawnJSWebWorkersBlazor>
	</PropertyGroup>

	<ItemGroup>

		<PackageReference Include="SpawnDev.Reachy" Version="0.1.0-preview.4" />
		<PackageReference Include="SpawnDev.Reachy.Browser" Version="0.1.0-preview.5" />
		
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.2.2" />

		<!-- Required in the exe project (this one) -->
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.2" />

		<!-- DIRECT: demo libs (voices, characters, prefs, consent) use IAsyncFS / OPFS. Previously
		     arrived only transitively via SpawnDev.WebTorrent, which this app no longer references. -->
		<PackageReference Include="SpawnDev.AsyncFileSystem" Version="2.3.0" />

		<ProjectReference Include="..\SpawnDev.AI.Server\SpawnDev.AI.Server.csproj" />
	</ItemGroup>

	<!-- 🔴 STAMP THE BUILD TIME INTO THE ASSEMBLY. A browser is the easiest place to be served a stale
	     build - cached index.html, an old boot manifest, a CDN behind a deploy - and every one of those
	     looks like the code being wrong. BuildStamp prints this on startup so "did my change reach the
	     page" is answerable instead of guessed at. Evaluated at build time, deliberately: a value
	     computed at startup cannot tell new code from old. -->
	<PropertyGroup>
		<BuildStampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildStampUtc>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BuildStampUtc</_Parameter1>
			<_Parameter2>$(BuildStampUtc)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
