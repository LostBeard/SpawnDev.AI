<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Disable compression (optional, based on use case) -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Disables the Hot Reload background client for WASM -->
		<WasmEnableHotReload>false</WasmEnableHotReload>

		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>

	<ItemGroup>

		<PackageReference Include="SpawnDev.Reachy" Version="0.1.0-preview.3" />
		<PackageReference Include="SpawnDev.Reachy.Browser" Version="0.1.0-preview.4" />
		
		<PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.1.10" />

		<!-- Required in the exe project (this one) -->
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.1.18" />


		<ProjectReference Include="..\SpawnDev.AI.Server\SpawnDev.AI.Server.csproj" />
	</ItemGroup>

	<!-- 🔴 STAMP THE BUILD TIME INTO THE ASSEMBLY. A browser is the easiest place to be served a stale
	     build - cached index.html, an old boot manifest, a CDN behind a deploy - and every one of those
	     looks like the code being wrong. BuildStamp prints this on startup so "did my change reach the
	     page" is answerable instead of guessed at. Evaluated at build time, deliberately: a value
	     computed at startup cannot tell new code from old. -->
	<PropertyGroup>
		<BuildStampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildStampUtc>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BuildStampUtc</_Parameter1>
			<_Parameter2>$(BuildStampUtc)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
