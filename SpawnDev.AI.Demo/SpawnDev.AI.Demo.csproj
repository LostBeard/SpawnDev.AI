<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
		<!-- ILGPU resolves methods (Math.Clamp etc.) via reflection at runtime - trimming removes them
         and the WORKER dies with MissingMethodException in RemappedIntrinsics (hit on the first
         Pages deploy, 2026-07-04). Same standing rule as the ML demo: never trim, never AOT. -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>
	
	<PropertyGroup>
		<StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
	</PropertyGroup>
	
	<ItemGroup>
		<!-- Required in the exe project (this one) -->
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.1.2" />
		<!-- Add Blazor support to SpawnJS -->
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="2.1.7" />

		<ProjectReference Include="..\SpawnDev.AI.Server\SpawnDev.AI.Server.csproj" />
	</ItemGroup>

</Project>
