<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Authors>LostBeard</Authors>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<IsPackable>true</IsPackable>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.AI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.AI.git</RepositoryUrl>
		<PackageTags>AI;LLM;Ollama;DotNetWebAssembly;WebGPU;GGUF;ToolCalling</PackageTags>
		<Title>SpawnDev.AI.Server</Title>
		<Version>1.1.0-preview.3</Version>
		<PackageReleaseNotes>v1.1.0-preview.3 - Dependency update. Full history: CHANGELOG.md</PackageReleaseNotes>
		<Description>Ollama/OpenAI-compatible model server on the SpawnDev.ILGPU.ML inference engine (GGUF, KV-cache decode, WebGPU dispatch-plan capture/replay). One handler core, two transports: HTTP on desktop (drop-in for Ollama clients on :11434), MessagePort in the browser (shared/dedicated worker) - the same request/response shapes either way.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.AI\SpawnDev.AI.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.ILGPU.ML" Version="5.2.19" />
		<!-- Direct reference: ML 5.2.19 only asks for SpawnDev.ILGPU >= 5.2.12, and NuGet resolves the lowest
		     satisfying version, so without this the server and the demo would stay on 5.2.12. -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.2.16" />
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.1.18" />
	</ItemGroup>

</Project>
